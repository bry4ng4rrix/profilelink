# Copy to .env and replace every <...> value. Never commit .env.

ENVIRONMENT=production

# Public URLs
FRONTEND_ORIGIN=https://profil.mg
API_PUBLIC_URL=https://api.profil.mg
COOKIE_DOMAIN=profil.mg

# PostgreSQL. Use a hex password: it is embedded in a URL.
POSTGRES_USER=profilelink
POSTGRES_DB=profilelink
POSTGRES_PASSWORD=<openssl rand -hex 32>

# Secrets. Changing IP_HASH_KEY only affects new events.
IP_HASH_KEY=<openssl rand -hex 32>
REVALIDATE_SECRET=<openssl rand -hex 32>

# Enables https://api.profil.mg/register, which creates administrators.
# Leave empty to disable the page: set it only while creating an account.
# 32 characters minimum: openssl rand -hex 32
REGISTRATION_TOKEN=
